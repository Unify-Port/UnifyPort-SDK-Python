{
  "schemaVersion": 1,
  "defaults": {
    "retryable": false,
    "secretInput": false,
    "secretOutput": false,
    "mcpExposure": "never"
  },
  "headerAllowlist": [
    "X-Request-Id"
  ],
  "headerPolicySource": "sdk_transport_policy",
  "authenticationHeadersExposed": false,
  "retryAllowlist": [
    "getAccount",
    "getAccountAuthState",
    "getContact",
    "getConversation",
    "getGroup",
    "getGroupInviteCode",
    "getWebhookEndpoint",
    "getWorkspace",
    "listAccounts",
    "listApiKeys",
    "listContactBlocklist",
    "listContacts",
    "listConversationLabels",
    "listConversationMembers",
    "listConversations",
    "listGroupJoinRequests",
    "listGroups",
    "listProviderRegions",
    "listWebhookEndpoints"
  ],
  "mutabilityOverrides": {
    "deleteAccount": "destructive",
    "deleteConversationLabel": "destructive",
    "deleteWebhookEndpoint": "destructive",
    "leaveGroup": "destructive",
    "revokeMessage": "destructive",
    "updateGroupJoinRequests": "destructive",
    "updateGroupMembers": "destructive"
  },
  "secretInput": [
    "createAccount",
    "createWebhookEndpoint",
    "importAccountAuthSession",
    "sendMessage",
    "submitAccountAuthCode",
    "submitAccountAuthPassword",
    "updateAccount",
    "updateWebhookEndpoint"
  ],
  "secretOutput": [
    "checkAccountQrAuth",
    "createAccount",
    "createApiKey",
    "getAccount",
    "getAccountAuthState",
    "getGroupInviteCode",
    "listAccounts",
    "rotateApiKey",
    "sendMessage",
    "startAccountAuth",
    "startAccountQrAuth",
    "updateAccount"
  ],
  "nodeMcpExposure": {
    "getWorkspace": "read",
    "listApiKeys": "read",
    "listProviderRegions": "read",
    "updateApiKeyStatus": "write"
  },
  "pythonMcp": {
    "enabled": false,
    "defaultExposure": "never",
    "eligibleOperations": []
  }
}
